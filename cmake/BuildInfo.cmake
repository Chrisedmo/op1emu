# Writes op1_build_info.h: what a binary was built from, so measurements can say
# which two builds they compared. Run at every build (the revision changes
# without a reconfigure); the header is rewritten only when it changes.
#
# In: SOURCE_DIR, OUTPUT, BUILD_TYPE, PROFILING, COMPILER.

function(revision dir out_rev out_dirty)
    execute_process(COMMAND git -C "${dir}" rev-parse --short=12 HEAD
                    OUTPUT_VARIABLE rev RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(failed)
        set(${out_rev} "unknown" PARENT_SCOPE)
        set(${out_dirty} "false" PARENT_SCOPE)
        return()
    endif()
    # Tracked changes only; a submodule's untracked files (build trees,
    # caches) do not make the build differ.
    execute_process(COMMAND git -C "${dir}" status --porcelain --untracked-files=no --ignore-submodules=untracked
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(${out_rev} "${rev}" PARENT_SCOPE)
    if(changes)
        set(${out_dirty} "true" PARENT_SCOPE)
    else()
        set(${out_dirty} "false" PARENT_SCOPE)
    endif()
endfunction()

revision("${SOURCE_DIR}" host host_dirty)
revision("${SOURCE_DIR}/ext/bcore" bcore bcore_dirty)
if(NOT BUILD_TYPE)
    set(BUILD_TYPE "none")
endif()
if(PROFILING)
    set(profiling "true")
else()
    set(profiling "false")
endif()

set(json "{\\\"schema\\\":\\\"op1.build.v1\\\",\\\"host\\\":\\\"${host}\\\",\\\"host_dirty\\\":${host_dirty},\\\"bcore\\\":\\\"${bcore}\\\",\\\"bcore_dirty\\\":${bcore_dirty},\\\"build_type\\\":\\\"${BUILD_TYPE}\\\",\\\"profiling\\\":${profiling},\\\"compiler\\\":\\\"${COMPILER}\\\"}")
file(WRITE "${OUTPUT}.tmp" "#pragma once\n// Generated by cmake/BuildInfo.cmake at build time.\n#define OP1_BUILD_INFO_JSON \"${json}\"\n")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
file(REMOVE "${OUTPUT}.tmp")
